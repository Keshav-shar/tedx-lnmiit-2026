---
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  return [{ params: { slug: "tickets-live" } }];
}

const updates = {
  "tickets-live": {
    title: "TEDx LNMIIT 2026 Tickets Now Live – ₹499 Only",
    description: "Registrations for TEDx LNMIIT 2026 are officially open. Ticket price is ₹499.",
    date: "2026-01-06T18:30:00+05:30",
    content: `
      Registrations for TEDx LNMIIT 2026 are now officially open.

      Students and professionals can book their seats for just ₹499 and experience a day of
      powerful talks, innovative ideas and inspiring stories at LNMIIT Jaipur.

      This year’s edition will feature speakers from diverse fields including entrepreneurship,
      mental health, technology, leadership and the creative arts.

      Seats are limited and will be filled on a first-come basis. We encourage all interested
      participants to register early to secure their place at the event.
    `
  }
};

const { slug } = Astro.params;
const post = updates[slug];
---

<MainLayout
  title={post.title}
  description={post.description}
  canonical={`https://www.tedxlnmiit.in/updates/${slug}`}
  type="article"
  published={post.date}
>

<section class="max-w-4xl mx-auto px-6 pt-24">
  <article>
    <h1 class="text-4xl font-semibold mb-4">{post.title}</h1>
    <time class="text-sm text-gray-500">{post.date}</time>
    <p class="mt-6 whitespace-pre-line">{post.content}</p>
  </article>
</section>

<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  "headline": post.title,
  "datePublished": post.date,
  "dateModified": post.date,
  "mainEntityOfPage": `https://www.tedxlnmiit.in/updates/${slug}`,
  "publisher": {
    "@type": "Organization",
    "name": "TEDx LNMIIT",
    "logo": {
      "@type": "ImageObject",
      "url": "https://www.tedxlnmiit.in/favicon.webp"
    }
  }
})}></script>

</MainLayout>
