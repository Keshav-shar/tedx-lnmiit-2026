---
import MainLayout from "../../layouts/MainLayout.astro";

export async function getStaticPaths() {
  return [
    { params: { speaker: "gunjan-saini" } },
    { params: { speaker: "preksha-kaparwan" } },
    { params: { speaker: "deepak-pareek" } },
    { params: { speaker: "chinmay-gaur" } },
    { params: { speaker: "dr-ajay-data" } },
    { params: { speaker: "krishnan-sunderarajan" } },
    { params: { speaker: "dr-lopa-mudraa" } },
    { params: { speaker: "dr-kamna-chhibber" } },
    { params: { speaker: "aabha-hanjura" } },
    { params: { speaker: "chetna-balhara" } },
    { params: { speaker: "shelly-jyoti" } },
  ];
}

const talks = {
  "gunjan-saini": {
    name: "Gunjan Saini",
    embedId: "7Qsg9A-mjgk",
    description: "TEDx LNMIIT talk by Gunjan Saini",
  },
  "preksha-kaparwan": {
    name: "Preksha Kaparwan",
    embedId: "rVfCN04AEmg",
    description: "TEDx LNMIIT talk by Preksha Kaparwan",
  },
  "deepak-pareek": {
    name: "Deepak Pareek",
    embedId: "vkIZJ0-hkQY",
    description: "TEDx LNMIIT talk by Deepak Pareek",
  },
  "chinmay-gaur": {
    name: "Chinmay Gaur",
    embedId: "KyLREMG86r0",
    description: "TEDx LNMIIT talk by Chinmay Gaur",
  },
  "dr-ajay-data": {
    name: "Dr. Ajay Data",
    embedId: "JfBAk9jj--0",
    description: "TEDx LNMIIT talk by Dr. Ajay Data",
  },
  "krishnan-sunderarajan": {
    name: "Krishnan Sunderarajan",
    embedId: "Z9zx3kWLP6c",
    description: "TEDx LNMIIT talk by Krishnan Sunderarajan",
  },
  "dr-lopa-mudraa": {
    name: "Dr. Lopa Mudraa",
    embedId: "To9sxO9W_Kw",
    description: "TEDx LNMIIT talk by Dr. Lopa Mudraa",
  },
  "dr-kamna-chhibber": {
    name: "Dr. Kamna Chhibber",
    embedId: "n0me_a9Amnk",
    description: "TEDx LNMIIT talk by Dr. Kamna Chhibber",
  },
  "aabha-hanjura": {
    name: "Aabha Hanjura",
    embedId: "omzsDD9-Ur8",
    description: "TEDx LNMIIT talk by Aabha Hanjura",
  },
  "chetna-balhara": {
    name: "Chetna Balhara",
    embedId: "357IYm05oQU",
    description: "TEDx LNMIIT talk by Chetna Balhara",
  },
  "shelly-jyoti": {
    name: "Shelly Jyoti",
    embedId: "Vu_gdUgJAzk",
    description: "TEDx LNMIIT talk by Shelly Jyoti",
  },
};

const { speaker } = Astro.params;
const talk = talks[speaker];

if (!talk) throw new Error("Talk not found");

const embedUrl =
  `https://www.youtube-nocookie.com/embed/${talk.embedId}?rel=0&playsinline=1`;
---

<MainLayout
  title={`${talk.name} | TEDx LNMIIT`}
  description={talk.description}
  canonical={`https://www.tedxlnmiit.in/talks/${speaker}`}
>
  <section class="min-h-screen flex flex-col items-center justify-center px-4 py-20">
    <h1 class="text-3xl md:text-4xl font-light text-[#EB0028] mb-8 text-center">
      {talk.name}
    </h1>

    <iframe
      class="w-full max-w-5xl aspect-video rounded-2xl border border-red-600"
      src={embedUrl}
      allow="accelerometer; encrypted-media; gyroscope; picture-in-picture; fullscreen"
      allowfullscreen
    ></iframe>
  </section>

  <script
    type="application/ld+json"
    set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "VideoObject",
      "name": talk.name,
      "description": talk.description,
      "thumbnailUrl": `https://img.youtube.com/vi/${talk.embedId}/hqdefault.jpg`,
     "uploadDate": "2025-01-01T00:00:00+05:30",
      "contentUrl": `https://www.youtube.com/watch?v=${talk.embedId}`,
        "embedUrl": embedUrl,
      "publisher": {
        "@type": "Organization",
        "name": "TEDx LNMIIT",
        "logo": {
          "@type": "ImageObject",
          "url": "https://tedxlnmiit.in/favicon.webp"
        }
      }
    })}
  ></script>
</MainLayout>
