---
import MainLayout from "../layouts/MainLayout.astro";
import SpeakersCarousel from '../components/CurrentSpeakers.jsx';
import PastSpeakers from "../components/PastSpeakers.jsx";
import FAQPage from "../components/FAQ.jsx";
import SponsorsComponent from '../components/Sponsors.jsx';
---

<MainLayout title="TEDxLNMIIT">
  <!-- HERO SECTION -->
<section 
  class="relative flex  items-center justify-center 
          min-h-[calc(100vh-80px)] overflow-hidden 
         pt-6 px-4"
>

  <!-- BACKGROUND TEXT — Mobile only -->
  <div 
    class="absolute inset-0 flex flex-col items-center justify-center 
           sm:hidden text-center pointer-events-none select-none"
  >
    <p class="text-[18vw] font-extrabold leading-[0.8] 
              text-red-900/30 tracking-tight">
      FORGING
    </p>

    <p class="text-[6vw] font-bold text-red-900/20 -mt-4 tracking-widest">
      THE
    </p>

    <p class="text-[18vw] font-extrabold leading-[0.8] 
              text-gray-400/20 tracking-tight -mt-4">
      FUTURE
    </p>
  </div>


  <!-- Title Image (Laptop only) -->
  <div class="hidden sm:flex justify-center items-center mb-6">
    <img 
      src="/graphics/bg-Forging5.png"
      alt="Forging the Future"
      loading="lazy"
      class="max-w-[70vw] md:max-w-[45vw] h-auto object-contain 
             "
    />
  </div>

  <!-- Sculpture Image (Both mobile + desktop) -->
  <img 
    src="/images/MainElement2.png"  
    alt="TEDx LNMIIT Hero" 
    loading="lazy"
    class="object-contain w-[85vw] sm:w-auto 
           max-h-[65vh] sm:max-h-[80vh]
           transition-opacity duration-500 opacity-0 relative z-10"
    onload="this.style.opacity='1'"
  />

</section>

<!-- COUNTDOWN SECTION -->
<section class="relative w-full   py-20 flex flex-col items-center text-center px-4">
  <!-- Heading -->
 <h1
  class="
    text-center
    font-light
    tracking-tight
    leading-[1]
    max-w-[92vw]
    mx-auto
    py-5
    text-[clamp(2.6rem,9vw,5.5rem)]
  "
>
  <span class="text-[#EB0028]">Hello</span>{" "}
  <span class="text-white">Explorer</span>
</h1>


  <!-- Countdown Container -->
  <div class=" border border-red-600 px-6 py-8 md:px-12 md:py-10 rounded-2xl  backdrop-blur-sm w-full max-w-3xl mx-auto">
  <div class="text-gray-300 mb-6 tracking-widest uppercase text-sm md:text-base text-center">
    Time Until the Event
  </div>

  <!-- Countdown Boxes -->
  <div id="countdown" 
       class="grid grid-cols-2 sm:grid-cols-4 gap-4 sm:gap-6 justify-center items-center">
    <div class="count-box">
      <div id="days" class="count-number">0</div>
      <div class="count-label">Days</div>
    </div>
    <div class="count-box">
      <div id="hours" class="count-number">0</div>
      <div class="count-label">Hours</div>
    </div>
    <div class="count-box">
      <div id="minutes" class="count-number">0</div>
      <div class="count-label">Minutes</div>
    </div>
    <div class="count-box">
      <div id="seconds" class="count-number">0</div>
      <div class="count-label">Seconds</div>
    </div>
  </div>
</div>

  <!-- Description -->
  <p class="max-w-2xl text-lg md:text-xl mt-12 leading-relaxed font-medium text-gray-200">
    Join us as we bring <span class="text-[#EB0028] font-semibold">bold ideas</span> and pioneers together — 
    a celebration of <span class="text-white font-semibold">creativity</span>, 
    <span class="text-red-500 font-semibold">innovation</span>, and the people shaping tomorrow.
  </p>
</section>

  <!-- ================= TEASER VIDEO ================= -->
  <section class="w-full py-20 px-6 flex justify-center">
    <div class="max-w-5xl w-full border-2 border-red-600 rounded-2xl overflow-hidden">
      <!-- DESKTOP -->
<iframe
      class="hidden md:block w-full aspect-video"
      src="https://www.youtube.com/embed/xGv4oAeEe6M?autoplay=1&mute=1&controls=1"
      allow="autoplay; encrypted-media"
      allowfullscreen
    ></iframe>
<!-- MOBILE -->
<a
  href="https://www.youtube.com/watch?v=xGv4oAeEe6M"
  target="_blank"
  class="block md:hidden"
>
  <img
    src="https://img.youtube.com/vi/xGv4oAeEe6M/hqdefault.jpg"
    class="w-full rounded-2xl"
  />
</a>

    </div>
  </section>




<style>
  .count-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #0d0d0d;
  border: 1.5px solid rgba(255, 0, 0, 0.5);
  border-radius: 1rem;
  padding: 1rem 0.75rem;
  box-shadow: none;
  transition: none;
  min-width: 65px;
}


  .count-number {
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    text-shadow: 0 0 10px rgba(255, 0, 0, 0.5);
  }

  .count-label {
    margin-top: 0.3rem;
    color: #e5e5e5;
    font-weight: 500;
    text-transform: uppercase;
    font-size: 0.75rem;
    letter-spacing: 1px;
  }

  /* Responsive adjustments */
  @media (max-width: 640px) {
    .count-number {
      font-size: 1.5rem;
    }
    .count-label {
      font-size: 0.7rem;
    }
    .count-box {
      padding: 0.8rem 0.6rem;
      border-radius: 0.75rem;
    }
  }
</style>


<SpeakersCarousel client:visible/>

<h1
  class="
    relative z-10
    text-center
    font-light
    tracking-tight
    leading-tight
    max-w-[92vw]
    mx-auto
    py-0
    -mb-8
    text-[clamp(2.4rem,8vw,4.5rem)]
  "
>
  <span class="text-gray-100">Past</span>{" "}
  <span class="text-[#EB0028]">Speakers</span>
</h1>


<PastSpeakers client:visible/>

<SponsorsComponent client:visible/>


<FAQPage client:visible/>


</MainLayout>







<!-- COUNTDOWN SCRIPT -->
<script type="module">
  const EVENT_ISO = '2026-01-10T09:00:00+05:30';

  (function initCountdown() {
    const daysEl = document.getElementById('days');
    const hoursEl = document.getElementById('hours');
    const minutesEl = document.getElementById('minutes');
    const secondsEl = document.getElementById('seconds');

    function update() {
      const now = new Date();
      const target = new Date(EVENT_ISO);
      const diff = target - now;
      if (diff <= 0) {
        [daysEl, hoursEl, minutesEl, secondsEl].forEach(el => el.textContent = '0');
        clearInterval(interval);
        return;
      }

      const totalSeconds = Math.floor(diff / 1000);
      const secs = totalSeconds % 60;
      const mins = Math.floor(totalSeconds / 60) % 60;
      const hrs = Math.floor(totalSeconds / 3600) % 24;
      const days = Math.floor(totalSeconds / 86400);

      daysEl.textContent = days;
      hoursEl.textContent = String(hrs).padStart(2, '0');
      minutesEl.textContent = String(mins).padStart(2, '0');
      secondsEl.textContent = String(secs).padStart(2, '0');
    }

    update();
    const interval = setInterval(update, 1000);
  })();
</script>
